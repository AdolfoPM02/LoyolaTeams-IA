<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="blocks/ragassistant/db" VERSION="20240601" COMMENT="XMLDB file for block ragassistant">
  <TABLES>
    <TABLE NAME="block_ragassistant_log" COMMENT="Log de consultas al asistente RAG">
      <FIELDS>
        <FIELD NAME="id"             TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="courseid"       TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="userid"         TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="contextid"      TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="cmid"           TYPE="int"  LENGTH="10" NOTNULL="false"/>
        <FIELD NAME="question_hash"  TYPE="char" LENGTH="64" NOTNULL="false"/>
        <FIELD NAME="status"         TYPE="char" LENGTH="32" NOTNULL="false" DEFAULT="ok"/>
        <FIELD NAME="sources_count"  TYPE="int"  LENGTH="5"  NOTNULL="false" DEFAULT="0"/>
        <FIELD NAME="confidence"     TYPE="number" LENGTH="5" DECIMALS="4" NOTNULL="false"/>
        <FIELD NAME="latency_ms"     TYPE="int"  LENGTH="10" NOTNULL="false"/>
        <FIELD NAME="timecreated"    TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="courseid" UNIQUE="false" FIELDS="courseid"/>
        <INDEX NAME="userid"   UNIQUE="false" FIELDS="userid"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
